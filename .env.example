# CallKind configuration. Copy to .env and fill in. .env is git-ignored.
# APP_MODE: live | fixture
APP_MODE=live

# --- NVIDIA hosted Nemotron (classification) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Must be a Nemotron model your account can actually call. Verify with:
#   python backend/scripts/smoke_nvidia.py
NVIDIA_MODEL=

# --- ElevenLabs (speech in / speech out) ---
ELEVENLABS_API_KEY=
# Stock voice id from your account. Verify with:
#   python backend/scripts/smoke_elevenlabs.py
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# --- server ---
ALLOWED_ORIGINS=http://localhost:5173

# Optional second Nemotron, used only if the primary returns a transient 429/503.
NVIDIA_MODEL_FALLBACK=
